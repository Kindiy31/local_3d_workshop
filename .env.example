# Linux/WSL paths. Copy to .env; never commit the local .env.
# Defaults: ~/.local/share/local-3d-workshop and ./runtime
WORKSHOP_PORT=7861
WSL_DISTRO=Ubuntu-22.04
# HUNYUAN_HOME=/absolute/path/to/Hunyuan3D-2
# HUNYUAN_PYTHON=/absolute/path/to/Hunyuan3D-2/.venv/bin/python
# HUNYUAN_MODELS=/absolute/path/to/models
# WORKSHOP_DATA=/absolute/path/to/runtime
# Optional n8n (leave disabled if not installed):
# HUNYUAN_N8N_WEBHOOK=http://127.0.0.1:5678/webhook/hunyuan-monitor
